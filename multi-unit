<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Step 1: Agency & District Test</title>
  <style>
    body { font-family: system-ui, sans-serif; padding: 16px; background: #f8f9fa; color: #222; font-size: 14px; }
    .box { background: #fff; padding: 16px; border-radius: 8px; border: 1px solid #dee2e6; max-width: 500px; }
    select { width: 100%; padding: 8px; margin-top: 8px; font-size: 14px; border: 1px solid #0078d4; border-radius: 4px; }
    #log { margin-top: 12px; padding: 10px; background: #f1f3f5; border-radius: 4px; font-size: 12px; }
  </style>
</head>
<body>
  <div class="box">
    <strong>Step 1 Test: Dropdown Connection</strong>
    <select id="agency" onchange="loadDistricts()">
      <option value="">-- 1. Select Agency --</option>
      <option value="USFS">USFS (Ranger Districts)</option>
      <option value="BLM">BLM (Field Offices)</option>
      <option value="NPS">NPS (Parks & Monuments)</option>
      <option value="FWS">FWS (Wildlife Refuges)</option>
      <option value="BIA">BIA (Tribal Lands)</option>
    </select>

    <select id="district" onchange="districtSelected()" disabled>
      <option value="">-- 2. Select District / Unit --</option>
    </select>

    <div id="log">Page loaded! Pick an agency above to test the live connection.</div>
  </div>

  <script>
    const SERVICES = {
      USFS: { url: "https://services2.arcgis.com/FiaPA4ga0iQKduv3/arcgis/rest/services/Forest_Service_Ranger_Districts/FeatureServer/0", field: "DISTRICTNAME" },
      BLM:  { url: "https://services2.arcgis.com/FiaPA4ga0iQKduv3/arcgis/rest/services/blm_natl_admu_field_poly_webpub_A_view/FeatureServer/0", field: "ADMU_NAME" },
      NPS:  { url: "https://services1.arcgis.com/fBc8EJBxQRMcHlei/arcgis/rest/services/NPS_Land_Resources_Division_Boundary_and_Tract_Data_Service/FeatureServer/2", field: "UNIT_NAME" },
      FWS:  { url: "https://services.arcgis.com/QVENGdaPbd4LUkLV/arcgis/rest/services/National_Wildlife_Refuge_System_Boundaries/FeatureServer/0", field: "ORGNAME" },
      BIA:  { url: "https://biamaps.geoplatform.gov/server/rest/services/DivLTR/BIA_AIAN_National_LAR/MapServer/0", field: "LARName" }
    };

    async function loadDistricts() {
      const agency = document.getElementById("agency").value;
      const distSel = document.getElementById("district");
      const log = document.getElementById("log");

      distSel.innerHTML = '<option value="">-- 2. Select District / Unit --</option>';
      distSel.disabled = true;
      if (!agency) return;

      const { url, field } = SERVICES[agency];
      log.innerText = `Querying ${agency} service...`;

      try {
        const res = await fetch(`${url}/query?where=1%3D1&outFields=${field}&returnGeometry=false&returnDistinctValues=true&orderByFields=${field}&f=json`);
        const data = await res.json();
        if (data.error) throw new Error(data.error.message);

        const names = [...new Set(data.features.map(f => f.attributes[field]).filter(Boolean))].sort();
        names.forEach(name => {
          const opt = document.createElement("option");
          opt.value = name;
          opt.textContent = name;
          distSel.appendChild(opt);
        });

        distSel.disabled = false;
        log.innerText = `Success! Loaded ${names.length} ${agency} units.`;
      } catch (err) {
        log.innerText = `Error: ${err.message}`;
      }
    }

    function districtSelected() {
      const val = document.getElementById("district").value;
      document.getElementById("log").innerText = val ? `Selected: ${val}` : "Pick a district.";
    }
  </script>
</body>
</html>
